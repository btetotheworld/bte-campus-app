{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:schema-action-tests": "node scripts/check-schema-action-tests.mjs",
    "setup": "node scripts/setup.mjs",
    "predb:reset": "node scripts/guard-local.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "predb:seed": "node scripts/guard-local.mjs",
    "db:seed": "node scripts/db-reset.mjs",
    "predb:seed-auth": "node scripts/guard-local.mjs",
    "db:seed-auth": "node scripts/seed-local-auth.mjs",
    "predb:test": "node scripts/guard-local.mjs",
    "db:test": "psql \"$(node scripts/local-db-url.mjs)\" -f db/tests/0001_invariants.test.sql",
    "predb:test:rbac": "node scripts/guard-local.mjs",
    "db:test:rbac": "psql \"$(node scripts/local-db-url.mjs)\" -v ON_ERROR_STOP=1 -f db/tests/0002_rbac.test.sql",
    "predb:test:rls": "node scripts/guard-local.mjs",
    "db:test:rls": "psql \"$(node scripts/local-db-url.mjs)\" -v ON_ERROR_STOP=1 -f db/tests/0003_rls.test.sql",
    "predb:test:join-applications": "node scripts/guard-local.mjs",
    "db:test:join-applications": "psql \"$(node scripts/local-db-url.mjs)\" -v ON_ERROR_STOP=1 -f db/tests/0005_join_applications.test.sql",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:new": "pnpm exec supabase --workdir db migration new",
    "db:diff": "pnpm exec supabase --workdir db db diff --local",
    "db:push": "echo 'Pushing to a REMOTE project. Read AGENTS.md first. Take a backup. Then run: pnpm exec supabase --workdir db db push' && exit 1",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-tailwindcss": "4.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{ts,tsx,js,jsx,mjs,json,css,md}": [
      "prettier --write"
    ]
  }
}
